# Turn an unsupported Node version into a clear install-time error instead of a
# warning you scroll past. Without this, npm only warns on EBADENGINE: `npm
# install` looks like it worked and you fail much later, confusingly, from
# inside playwright-core. The floor is Node 20 (see "engines" in package.json),
# set by Playwright itself.
#
# Caveat worth knowing: this enforces every *dependency's* engines range, not
# just this project's. Today they're all open-ended (dotenv >=12, playwright
# >=20), so it can only reject versions that genuinely don't work. If a future
# dependency ever pins an upper bound, this could reject a Node version you'd
# otherwise be fine on — escape with `npm install --engine-strict=false`, or
# delete this file.
engine-strict=true
