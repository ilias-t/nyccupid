# Copy this file to .env.

# ---------------------------------------------------------------------------
# virtual monitor: Project Cupid marriage-license virtual appointment
# ---------------------------------------------------------------------------
# Skip this whole block if you only want the `pickup` monitor — `pickup` needs
# no NYC.ID account and no credentials whatsoever.

# Your NYC.ID login email.
NYC_ID_USERNAME=your-nycid-email@example.com

# REQUIRED to run this monitor in the background (`./bin/cupid start virtual`,
# i.e. normal use). This is not the optional convenience it looks like:
# Project Cupid keeps its logged-in state only in a browser tab's
# sessionStorage, so the poller has to log itself back in every single time it
# starts — a session saved by `./bin/cupid login virtual` never survives into
# it. Without a stored password the poller cannot authenticate unattended.
#
# Leave it blank ONLY if you intend to run `login virtual` interactively and
# never use the background poller, which defeats the point of the tool.
#
# Safe to store here: this file is gitignored, and it's read only by local
# Node code that hands it straight to Playwright's fill() — never printed,
# logged, or sent anywhere.
NYC_ID_PASSWORD=

# Application/scheduling identifiers for your Project Cupid application.
# You dig these out of your browser's DevTools once — the step-by-step recipe
# is in the README, under "Setup: virtual". They're stable for the life of
# your application, so you never have to find them again.
CUPID_VIRTUAL_EVENT_ID=
CUPID_VIRTUAL_APPLICATION_ID=
CUPID_VIRTUAL_SUBMISSION_ID=
CUPID_VIRTUAL_FORM_ID=

# Watch window (inclusive), YYYY-MM-DD. Your dates, not anyone else's.
WATCH_VIRTUAL_START_DATE=YYYY-MM-DD
WATCH_VIRTUAL_END_DATE=YYYY-MM-DD

# Optional per-monitor poll-interval override — falls back to the global
# POLL_INTERVAL_SECONDS below if unset.
# CUPID_VIRTUAL_POLL_INTERVAL_SECONDS=75

# ---------------------------------------------------------------------------
# pickup monitor: in-person license pickup at a City Clerk office
# ---------------------------------------------------------------------------
# This is a completely different system from Project Cupid — a public,
# unauthenticated Salesforce scheduler (clerkscheduler.cityofnewyork.us). No
# NYC.ID login needed, no eventId/formId to find in DevTools.

# Office to watch. Must match one of the scheduler's picklist labels exactly
# (case-insensitive):
#   Bronx Office, Brooklyn Office, Manhattan Office, Queens Office,
#   Staten Island Office
# Note there is no option literally labeled "City Hall" — if that's what you
# mean, you want "Manhattan Office" (141 Worth Street).
CUPID_PICKUP_OFFICE_LABEL=

# Watch window (inclusive), YYYY-MM-DD. Your dates, not anyone else's.
# Keep this narrow on purpose: this endpoint is unauthenticated with no
# visible rate limit, and is queried once per day in range, per poll cycle —
# a wide range means a lot of requests. A window spanning more than 22 dates
# is refused at startup (MAX_WATCH_DAYS in src/monitors/pickup.js).
WATCH_PICKUP_START_DATE=YYYY-MM-DD
WATCH_PICKUP_END_DATE=YYYY-MM-DD

# Optional per-monitor poll-interval override — falls back to the global
# POLL_INTERVAL_SECONDS below if unset.
# CUPID_PICKUP_POLL_INTERVAL_SECONDS=75

# ---------------------------------------------------------------------------
# Shared across both monitors
# ---------------------------------------------------------------------------

# Poll interval in seconds. 60 is a hard floor — anything lower is clamped up
# to 60 in code, for both monitors. 75 is a good default. This is the global
# fallback; see the per-monitor overrides above if you want them polled
# differently.
POLL_INTERVAL_SECONDS=75

# Optional secondary notification channel
SLACK_WEBHOOK_URL=

# Optional: push notification via ntfy.sh (https://ntfy.sh) — this is what
# reaches your phone while the poller runs unattended. No account/signup
# needed: invent a topic name below, then install the ntfy app (iOS/Android)
# and subscribe to that exact same topic name.
#
# Generate one instead of thinking one up:
#     openssl rand -hex 16
# and paste the raw hex here. Don't prefix it with "nyccupid" or your name.
#
# Treat the topic name like a password, not a username — on the public
# ntfy.sh server the topic name is the ONLY access control, so anyone who
# knows or guesses it can subscribe to your notifications.
NTFY_TOPIC=
# Only needed if self-hosting ntfy; leave blank to use https://ntfy.sh
NTFY_SERVER=
